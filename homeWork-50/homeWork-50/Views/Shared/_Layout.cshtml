<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Products" asp-action="Index">Online Store</a>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Products" asp-action="Index">Все товары</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Products" asp-action="Create">Добавить товар</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Category" asp-action="Create">Добавить категорию</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Brand" asp-action="Create">Добавить бренд</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Order" asp-action="Index">Список заказов</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>