@model IEnumerable<homeWork_50.Models.Product>

@{
    ViewData["Title"] = "Все товары";
}

<h2 class="mb-4">Список товаров</h2>


<div class="card p-3 mb-4 bg-light shadow-sm">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-bold">Категория</label>
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">Все категории</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Бренд</label>
            <select name="brandId" class="form-select" asp-items="ViewBag.Brands">
                <option value="">Все бренды</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Фильтровать</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    </form>
</div>


@if (!Model.Any())
{
    <div class="alert alert-warning text-center my-4 fs-5" role="alert">
        По выбранным критериям товары не найдены.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top p-2" alt="@item.Name" style="height: 220px; object-fit: contain;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-primary fw-bold mb-1">Цена: @item.Price.ToString("N0") сом</p>
                        <p class="card-text text-muted small mb-3">Дата: @item.CreatedAt.ToString("dd.MM.yyyy")</p>
                        <div class="mt-auto d-flex gap-2">
                            <a asp-controller="Order" asp-action="Create" asp-route-id="@item.Id" class="btn btn-outline-dark flex-fill">Заказать</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark flex-fill">Детали</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}