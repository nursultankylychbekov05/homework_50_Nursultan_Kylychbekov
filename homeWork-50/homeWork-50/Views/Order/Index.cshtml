@model IEnumerable<homeWork_50.Models.Order>

@{
    ViewData["Title"] = "Список заказов";
}

<h2 class="mb-4">Список оформленных заказов</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Заказов пока нет.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
            <tr>
                <th>№</th>
                <th>Покупатель</th>
                <th>Телефон</th>
                <th>Адрес</th>
                <th>Товар</th>
                <th>Дата и время</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CustomerName</td>
                    <td>@item.ContactPhone</td>
                    <td>@item.Address</td>
                    <td>@(item.Product?.Name ?? "Товар удален")</td>
                    <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}